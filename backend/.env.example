# ── Free AI keys (add at least one; Gemini recommended for Thai) ──────────────
# Gemini:     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:       https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Order to try them in. If one hits its free limit, the next one is used.
LLM_PROVIDERS=gemini,groq,openrouter

# Optional model overrides (run `python -m app.check_providers --models` to see options)
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=openrouter/free

# ── Paid (optional) ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the Next.js app runs (comma-separate several origins)
FRONTEND_ORIGIN=http://localhost:3000
