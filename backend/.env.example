# ── Free AI keys (add at least one; Gemini recommended for Thai) ──────────────
# Gemini:     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:       https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Order to try them in. If one hits its free limit, the next one is used.
LLM_PROVIDERS=gemini,groq,openrouter

# Optional model overrides (run `python -m app.check_providers --models` to see options).
# List several, comma-separated: if one is busy (503) or rate-limited, the next is tried.
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free

# ── AI logo images (free): FLUX on Cloudflare Workers AI ─────────────────────
# dash.cloudflare.com → AI → Workers AI → "Use REST API" → create token + copy Account ID
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ── Paid (optional) ──────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the Next.js app runs (comma-separate several origins)
FRONTEND_ORIGIN=http://localhost:3000

# ── App settings (all optional) ──────────────────────────────────────────────
# DATABASE_URL=sqlite:///./brandstudio.db
# SECRET_KEY=change-me-in-production
# DAILY_GENERATIONS=20
# TOKEN_DAYS=7
# COOKIE_SECURE=false

# ── Password reset emails (optional, free: brevo.com, 300 emails/day) ────────
# Without BREVO_API_KEY the reset link is printed in this terminal instead.
# BREVO_API_KEY=
# MAIL_FROM=you@example.com        # must be a sender you verified in Brevo
# MAIL_FROM_NAME=Palettai
# APP_URL=http://localhost:3000    # where reset links point (your Vercel URL in production)
